---
import Logo from './Logo.astro';
import { NPM, REPO, VERSION, url } from '../lib/site';

const path = Astro.url.pathname;
const nav = [
  { href: url('#skills'), label: 'Skills', active: path.includes('/skills/') },
  { href: url('docs/'), label: 'Docs', active: path.includes('/docs') },
  { href: url('changelog/'), label: 'Changelog', active: path.includes('/changelog') },
];
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur-md">
  <div class="mx-auto flex h-14 max-w-[1120px] items-center gap-6 px-4 sm:px-6">
    <a href={url()} class="flex items-center gap-2 text-fg" aria-label="Musyskills home">
      <Logo class="size-5" />
      <span class="text-[15px] font-semibold tracking-[-0.02em]">musyskills</span>
    </a>

    <nav aria-label="Main" class="hidden items-center gap-1 sm:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={item.active ? 'page' : undefined}
            class:list={[
              'rounded-md px-2.5 py-1.5 text-[14px] transition-colors hover:text-fg',
              item.active ? 'text-fg' : 'text-muted',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-1">
      <a
        href={NPM}
        class="hidden rounded-full border border-line px-2.5 py-0.5 font-mono text-[12px] text-muted transition-colors hover:border-line-strong hover:text-fg sm:inline-block"
        >v{VERSION}</a
      >
      <a href={REPO} class="grid size-9 place-items-center rounded-md text-muted transition-colors hover:text-fg" aria-label="Musyskills on GitHub">
        <svg viewBox="0 0 16 16" class="size-[18px]" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
      </a>
      <button
        type="button"
        data-theme-toggle
        class="grid size-9 place-items-center rounded-md text-muted transition-colors hover:text-fg"
        aria-label="Switch to dark theme"
      >
        <svg viewBox="0 0 16 16" class="size-4" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <circle cx="8" cy="8" r="6"></circle>
          <path d="M8 2a6 6 0 0 0 0 12Z" fill="currentColor" stroke="none"></path>
        </svg>
      </button>
    </div>
  </div>
  <nav aria-label="Main" class="flex gap-1 border-t border-line px-2 sm:hidden">
    {
      nav.map((item) => (
        <a
          href={item.href}
          aria-current={item.active ? 'page' : undefined}
          class:list={['px-2.5 py-2 text-[14px]', item.active ? 'text-fg' : 'text-muted']}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  // Module scripts run once; the header is replaced on every client-side
  // navigation, so listen on the document and re-sync the label per page.
  const root = document.documentElement;
  const current = () =>
    root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  const sync = () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    document.querySelector('[data-theme-toggle]')?.setAttribute('aria-label', `Switch to ${next} theme`);
  };
  document.addEventListener('astro:page-load', sync);
  document.addEventListener('click', (event) => {
    if (!(event.target as Element).closest('[data-theme-toggle]')) return;
    const next = current() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    sync();
  });
</script>
