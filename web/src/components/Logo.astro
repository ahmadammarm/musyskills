---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg viewBox="0 0 20 20" aria-hidden="true" class={className}>
  <rect width="20" height="20" rx="5" fill="currentColor"></rect>
  <path
    d="M6 6.5 9.5 10 6 13.5M11 13.5h3.5"
    fill="none"
    stroke="var(--bg)"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
