---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Command from '../../components/Command.astro';
import { REPO, summary, url } from '../../lib/site';

export async function getStaticPaths() {
  const skills = (await getCollection('skills')).sort((a, b) => a.id.localeCompare(b.id));
  return skills.map((skill, i) => ({
    params: { name: skill.id },
    props: { skill, prev: skills[i - 1], next: skills[i + 1] },
  }));
}

const { skill, prev, next } = Astro.props;
const { Content, headings } = await render(skill);
const toc = headings.filter((h) => h.depth === 2);
const hint = skill.data['argument-hint'];
---

<Base title={skill.id} description={summary(skill.data.description)}>
  <div class="container-site">
    <div class="grid grid-cols-1 gap-12 py-12 sm:py-14 lg:grid-cols-[minmax(0,1fr)_200px] lg:gap-16 lg:py-16">
      <article class="min-w-0">
        <nav aria-label="Breadcrumb" class="font-mono text-[13px] text-muted">
          <a href={url('#skills')} class="hover:text-fg">skills</a>
          <span class="px-1.5 text-line-strong">/</span>
          <span class="text-fg" aria-current="page">{skill.id}</span>
        </nav>

        <h1 class="mt-5 font-mono text-[clamp(1.625rem,1.3rem+1.6vw,2.25rem)] leading-tight font-medium tracking-[-0.03em] [overflow-wrap:anywhere]">
          <span class="sr-only">{skill.id}</span>
          <span aria-hidden="true" data-decrypt="700">{skill.id}</span>
        </h1>
        <p class="mt-4 max-w-[42rem] text-[16px] leading-7 text-muted">{skill.data.description}</p>

        <div class="mt-8 grid grid-cols-1 gap-3">
          <Command lines={[`npx musyskills add ${skill.id}`]} />
          <dl class="flex flex-wrap gap-x-8 gap-y-2 pt-1 text-[13px]">
            <div class="flex gap-2">
              <dt class="text-muted">Run it with</dt>
              <dd class="font-mono text-fg">/{skill.id}{hint && <span class="text-muted"> {hint}</span>}</dd>
            </div>
            <div class="flex gap-2">
              <dt class="text-muted">As a plugin</dt>
              <dd class="font-mono text-fg">/musyskills:{skill.id}</dd>
            </div>
            <div class="flex gap-2">
              <dt class="text-muted">Source</dt>
              <dd>
                <a href={`${REPO}/blob/main/skills/${skill.id}/SKILL.md`} class="font-mono text-fg underline decoration-line-strong underline-offset-4 hover:decoration-fg">
                  SKILL.md
                </a>
              </dd>
            </div>
          </dl>
        </div>

        <div class="doc mt-4">
          <Content />
        </div>

        <nav aria-label="More skills" data-spotlight-group data-reveal class="mt-16 grid grid-cols-1 gap-3 border-t border-line pt-8 sm:grid-cols-2">
          {
            prev ? (
              <a href={url(`skills/${prev.id}/`)} class="spotlight overflow-hidden rounded-lg border border-line px-4 py-3 transition-colors hover:border-line-strong">
                <span class="block text-[12px] text-muted">Previous</span>
                <span class="font-mono text-[14px]">{prev.id}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            next && (
              <a href={url(`skills/${next.id}/`)} class="spotlight overflow-hidden rounded-lg border border-line px-4 py-3 text-right transition-colors hover:border-line-strong">
                <span class="block text-[12px] text-muted">Next</span>
                <span class="font-mono text-[14px]">{next.id}</span>
              </a>
            )
          }
        </nav>
      </article>

      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <p class="font-mono text-[12px] tracking-[0.08em] text-muted uppercase">On this page</p>
          <ul class="mt-3 space-y-2 border-l border-line text-[13.5px]">
            {
              toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`} class="-ml-px block border-l border-transparent pl-3 text-muted transition-colors hover:border-fg hover:text-fg">
                    {h.text}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Base>
